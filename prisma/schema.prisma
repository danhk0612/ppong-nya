generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  name                   String?   @db.VarChar(120)
  email                  String    @unique @db.VarChar(255)
  emailVerified          DateTime? @db.DateTime(3)
  image                  String?   @db.VarChar(2048)
  role                   UserRole  @default(USER)
  passwordHash           String?   @db.VarChar(255)
  passwordChangeRequired Boolean   @default(false)
  createdAt              DateTime  @default(now()) @db.DateTime(3)
  updatedAt              DateTime  @updatedAt @db.DateTime(3)

  accounts         Account[]
  sessions         Session[]
  gameRecords      GameRecord[]
  playerSnapshots  PlayerSnapshot[]
  preferences      UserPreference[]
  favoritePlayers  FavoritePlayer[]
  gameNotes        GameNote[]
  searchHistory    SearchHistory[]
  statisticsCaches StatisticsCache[]
  savedItems       SavedItem[]
  auditLogs        AuditLog[]

  @@map("users")
}

model Account {
  id                String   @id @default(cuid())
  userId            String
  type              String   @db.VarChar(64)
  provider          String   @db.VarChar(64)
  providerAccountId String   @db.VarChar(191)
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?  @db.VarChar(64)
  scope             String?  @db.Text
  id_token          String?  @db.Text
  session_state     String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @db.DateTime(3)
  updatedAt         DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @db.VarChar(191)
  userId       String
  expires      DateTime @db.DateTime(3)
  ipAddress    String?  @db.VarChar(45)
  userAgent    String?  @db.VarChar(512)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

model VerificationToken {
  identifier String   @db.VarChar(191)
  token      String   @unique @db.VarChar(191)
  expires    DateTime @db.DateTime(3)

  @@unique([identifier, token])
  @@map("verification_tokens")
}

/// User-owned game records imported from external sources or manually created.
model GameRecord {
  id             String    @id @default(cuid())
  userId         String?
  externalId     String?   @db.VarChar(191)
  source         String?   @db.VarChar(80)
  sourceRecordId String?   @db.VarChar(191)
  uuid           String?   @db.VarChar(191)
  mode           GameMode
  externalModeId Int?
  startedAt      DateTime  @db.DateTime(3)
  endedAt        DateTime? @db.DateTime(3)
  tableName      String?   @db.VarChar(120)
  rounds         Int?
  metadata       Json?
  rawPayload     Json?
  createdAt      DateTime  @default(now()) @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @db.DateTime(3)

  user              User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  players           Player[]
  notes             GameNote[]
  favoriteLinks     FavoriteGameRecord[]
  cachedPlayerLinks CachedPlayerGameRecord[]

  @@unique([userId, externalId])
  @@unique([source, sourceRecordId])
  @@unique([source, uuid])
  @@index([userId])
  @@index([mode, startedAt])
  @@index([externalModeId, startedAt])
  @@map("game_records")
}

model Player {
  id           String   @id @default(cuid())
  gameRecordId String
  seat         Int
  accountId    String?  @db.VarChar(191)
  nickname     String   @db.VarChar(120)
  rankLabel    String?  @db.VarChar(64)
  score        Int
  placement    Int
  ratingDelta  Decimal? @db.Decimal(10, 3)
  metadata     Json?
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  gameRecord GameRecord @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@unique([gameRecordId, seat])
  @@index([accountId])
  @@index([placement])
  @@map("players")
}

model CachedPlayer {
  id              String    @id @default(cuid())
  playerId        String    @unique @map("player_id") @db.VarChar(191)
  nickname        String    @db.VarChar(120)
  level           Int?
  maxLevel        Int?      @map("max_level")
  latestTimestamp BigInt?   @map("latest_timestamp")
  lastAccessedAt  DateTime  @default(now()) @map("last_accessed_at") @db.DateTime(3)
  lastUpdatedAt   DateTime? @map("last_updated_at") @db.DateTime(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  gameRecords       CachedPlayerGameRecord[]
  queryCoverages    PlayerQueryCoverage[]
  statisticsCaches PlayerStatisticsCache[]

  @@index([nickname])
  @@index([lastAccessedAt])
  @@index([lastUpdatedAt])
  @@map("cached_players")
}

model CachedPlayerGameRecord {
  cachedPlayerId String   @map("cached_player_id")
  gameRecordId   String   @map("game_record_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)

  cachedPlayer CachedPlayer @relation(fields: [cachedPlayerId], references: [id], onDelete: Cascade)
  gameRecord   GameRecord   @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@id([cachedPlayerId, gameRecordId])
  @@index([gameRecordId])
  @@map("cached_player_game_records")
}

model PlayerQueryCoverage {
  id             String   @id @default(cuid())
  cachedPlayerId String   @map("cached_player_id")
  modeKey        String   @map("mode_key") @db.VarChar(191)
  periodStart    DateTime @map("period_start") @db.DateTime(3)
  periodEnd      DateTime @map("period_end") @db.DateTime(3)
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.DateTime(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  cachedPlayer CachedPlayer @relation(fields: [cachedPlayerId], references: [id], onDelete: Cascade)

  @@unique([cachedPlayerId, modeKey, periodStart, periodEnd])
  @@index([cachedPlayerId, periodStart, periodEnd])
  @@index([fetchedAt])
  @@map("player_query_coverages")
}

model PlayerStatisticsCache {
  id             String    @id @default(cuid())
  cachedPlayerId String    @map("cached_player_id")
  cacheKey       String    @unique @map("cache_key") @db.VarChar(191)
  modeKey        String    @map("mode_key") @db.VarChar(191)
  periodStart    DateTime  @map("period_start") @db.DateTime(3)
  periodEnd      DateTime  @map("period_end") @db.DateTime(3)
  payload        Json
  computedAt     DateTime  @default(now()) @map("computed_at") @db.DateTime(3)
  expiresAt      DateTime? @map("expires_at") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  cachedPlayer CachedPlayer @relation(fields: [cachedPlayerId], references: [id], onDelete: Cascade)

  @@index([cachedPlayerId, periodStart, periodEnd])
  @@index([expiresAt])
  @@map("player_statistics_caches")
}

/// User settings such as locale, default game mode, visible columns, and UI options.
model UserPreference {
  id        String   @id @default(cuid())
  userId    String
  key       String   @db.VarChar(80)
  value     Json
  createdAt DateTime @default(now()) @db.DateTime(3)
  updatedAt DateTime @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_preferences")
}

/// User-owned favorite players for quick access and tracking.
model FavoritePlayer {
  id          String   @id @default(cuid())
  userId      String
  playerId    String   @db.VarChar(191)
  nickname    String   @db.VarChar(120)
  displayName String?  @db.VarChar(120)
  server      String?  @db.VarChar(64)
  memo        String?  @db.Text
  metadata    Json?
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRecords FavoriteGameRecord[]

  @@unique([userId, playerId])
  @@index([userId, nickname])
  @@map("favorite_players")
}

/// Links shared external game records to the favorite players that make them visible.
model FavoriteGameRecord {
  favoritePlayerId String
  gameRecordId     String
  createdAt        DateTime @default(now()) @db.DateTime(3)

  favoritePlayer FavoritePlayer @relation(fields: [favoritePlayerId], references: [id], onDelete: Cascade)
  gameRecord     GameRecord     @relation(fields: [gameRecordId], references: [id], onDelete: Cascade)

  @@id([favoritePlayerId, gameRecordId])
  @@index([gameRecordId])
  @@map("favorite_game_records")
}

/// User-owned notes attached to a game record or kept as standalone study notes.
model GameNote {
  id           String   @id @default(cuid())
  userId       String
  gameRecordId String?
  title        String   @db.VarChar(200)
  body         String   @db.Text
  tags         Json?
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRecord GameRecord? @relation(fields: [gameRecordId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([gameRecordId])
  @@map("game_notes")
}

/// User-owned search history for players, records, rankings, and statistics queries.
model SearchHistory {
  id          String   @id @default(cuid())
  userId      String
  query       String   @db.VarChar(255)
  scope       String?  @db.VarChar(80)
  filters     Json?
  resultCount Int?
  createdAt   DateTime @default(now()) @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([scope])
  @@map("search_history")
}

/// User-owned cached statistics snapshots derived from records and searches.
model StatisticsCache {
  id        String    @id @default(cuid())
  userId    String
  cacheKey  String    @db.VarChar(191)
  scope     String    @db.VarChar(80)
  payload   Json
  expiresAt DateTime? @db.DateTime(3)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cacheKey])
  @@index([userId, scope])
  @@index([expiresAt])
  @@map("statistics_caches")
}

/// Raw JSON cache for proxied upstream ppong-nya API responses.
model ExternalApiCache {
  id              String   @id @default(cuid())
  cacheKey        String   @unique @db.VarChar(191)
  endpoint        String   @db.VarChar(512)
  method          String   @default("GET") @db.VarChar(12)
  requestBody     String?  @db.LongText
  status          Int
  responseHeaders Json?
  payload         Json
  expiresAt       DateTime @db.DateTime(3)
  createdAt       DateTime @default(now()) @db.DateTime(3)
  updatedAt       DateTime @updatedAt @db.DateTime(3)

  @@index([endpoint])
  @@index([expiresAt])
  @@map("external_api_caches")
}

/// Materialized player-level summaries derived from local GameRecord rows or upstream responses during migration.
model PlayerSnapshot {
  id          String    @id @default(cuid())
  userId      String?
  playerId    String    @db.VarChar(191)
  nickname    String?   @db.VarChar(120)
  scope       String    @db.VarChar(80)
  modes       Json?
  periodStart DateTime? @db.DateTime(3)
  periodEnd   DateTime? @db.DateTime(3)
  source      String    @default("external") @db.VarChar(80)
  payload     Json
  computedAt  DateTime  @default(now()) @db.DateTime(3)
  expiresAt   DateTime? @db.DateTime(3)
  createdAt   DateTime  @default(now()) @db.DateTime(3)
  updatedAt   DateTime  @updatedAt @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId, scope])
  @@index([playerId])
  @@index([scope])
  @@index([expiresAt])
  @@map("player_snapshots")
}

/// Materialized aggregate statistics/ranking snapshots that can replace or cache upstream aggregate endpoints.
model StatisticsSnapshot {
  id         String    @id @default(cuid())
  cacheKey   String    @unique @db.VarChar(191)
  scope      String    @db.VarChar(80)
  modes      Json?
  period     String?   @db.VarChar(80)
  source     String    @default("external") @db.VarChar(80)
  payload    Json
  computedAt DateTime  @default(now()) @db.DateTime(3)
  expiresAt  DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)

  @@index([scope])
  @@index([expiresAt])
  @@map("statistics_snapshots")
}

model SavedItem {
  id          String        @id @default(cuid())
  userId      String
  type        SavedItemType
  title       String        @db.VarChar(200)
  targetId    String?       @db.VarChar(191)
  url         String?       @db.VarChar(2048)
  description String?       @db.Text
  data        Json?
  createdAt   DateTime      @default(now()) @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([targetId])
  @@map("saved_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String   @db.VarChar(120)
  entityType String?  @db.VarChar(120)
  entityId   String?  @db.VarChar(191)
  ipAddress  String?  @db.VarChar(45)
  userAgent  String?  @db.VarChar(512)
  metadata   Json?
  createdAt  DateTime @default(now()) @db.DateTime(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  USER
  ADMIN
}

enum GameMode {
  SANMA
  YONMA
}

enum SavedItemType {
  PLAYER
  GAME_RECORD
  RANKING
  SEARCH
  LINK
}
