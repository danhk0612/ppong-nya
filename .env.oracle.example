IMAGE_TAG=latest

PROXY_NETWORK=proxy
PUBLIC_SITE_URL=https://ppong-nya.mydepot.kr
PUBLIC_SITE_NAME=퐁냐
TZ=Asia/Seoul

PLAYER_CACHE_RETENTION_DAYS=90
PLAYER_CACHE_MAX_RECORDS=2000

# Mahjong Soul KR native collector.
# Keep real credentials only in the server .env file.
MAJSOUL_UID=
MAJSOUL_TOKEN=
MAJSOUL_DEVICE_ID=
MAJSOUL_OAUTH_TYPE=23
MAJSOUL_LOGIN_REGION=kr
MAJSOUL_ROUTE_ID=kr-2
MAJSOUL_RESOURCE_VERSION=0.16.238

COLLECTOR_POLL_INTERVAL_MS=7000
COLLECTOR_RECORD_DELAY_MS=1200000
COLLECTOR_RECORD_BATCH_SIZE=20
COLLECTOR_LIST_ONLY=false

MARIADB_DATABASE=ppong_nya
MARIADB_USER=ppong_nya
MARIADB_PASSWORD=replace-with-openssl-rand-hex-32
MARIADB_ROOT_PASSWORD=replace-with-another-openssl-rand-hex-32
MARIADB_DATA_DIR=./data/mariadb
