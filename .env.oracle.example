# Docker image published from the master branch.
IMAGE_TAG=latest

# Existing Docker network used by Nginx Proxy Manager.
PROXY_NETWORK=proxy
PUBLIC_SITE_URL=https://ppong-nya.mydepot.kr
PUBLIC_SITE_NAME=퐁냐
TZ=Asia/Seoul

# Shared player cache retention.
PLAYER_CACHE_RETENTION_DAYS=90
PLAYER_CACHE_MAX_RECORDS=2000

# Native Mahjong Soul collector. The collector service stays disabled until
# Docker Compose is started with --profile collector.
# Obtain UID/Token from your own Yostar quick-login request and keep them only
# in the real .env file. Never commit them.
MAJSOUL_UID=
MAJSOUL_TOKEN=
MAJSOUL_OAUTH_TYPE=22
MAJSOUL_URL_BASE=https://mahjongsoul.game.yo-star.com/
MAJSOUL_LOGIN_REGION=en
COLLECTOR_POLL_INTERVAL_MS=7000
COLLECTOR_RECORD_DELAY_MS=1200000
COLLECTOR_RECORD_BATCH_SIZE=20
COLLECTOR_LIST_ONLY=false

# Legacy collector authentication fallback. Leave empty for current Yostar login.
MAJSOUL_ACCESS_TOKEN=

# Use URL-safe hexadecimal values for database passwords because the application
# connection URL is assembled by Docker Compose.
MARIADB_DATABASE=ppong_nya
MARIADB_USER=ppong_nya
MARIADB_PASSWORD=replace-with-openssl-rand-hex-32
MARIADB_ROOT_PASSWORD=replace-with-another-openssl-rand-hex-32
MARIADB_DATA_DIR=./data/mariadb
