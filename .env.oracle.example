# Docker image published from the master branch.
IMAGE_TAG=latest

# Existing Docker network used by Nginx Proxy Manager.
PROXY_NETWORK=proxy
PUBLIC_SITE_URL=https://ppong-nya.mydepot.kr
PUBLIC_SITE_NAME=퐁냐
TZ=Asia/Seoul

# Use URL-safe hexadecimal values for database passwords because the application
# connection URL is assembled by Docker Compose.
MARIADB_DATABASE=ppong_nya
MARIADB_USER=ppong_nya
MARIADB_PASSWORD=replace-with-openssl-rand-hex-32
MARIADB_ROOT_PASSWORD=replace-with-another-openssl-rand-hex-32
MARIADB_DATA_DIR=./data/mariadb

# Generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-auth-secret

# Google OAuth is optional. Leave both values empty to use email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# This bootstrap account must change both its email and password after first login.
DEFAULT_ADMIN_EMAIL=admin@ppong-nya.local
DEFAULT_ADMIN_PASSWORD=replace-with-a-unique-bootstrap-password
