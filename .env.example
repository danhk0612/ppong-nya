# ppong-nya environment variables
# Copy this file to .env for local development. Never commit real secrets.

# MySQL connection string used only by Prisma on the server.
# Pool policy: keep connection_limit and pool_timeout in the URL. Defaults are
# also enforced in src/lib/server/db.ts when these parameters are omitted.
# - connection_limit: max DB connections per application process (local: 5, prod: 10)
# - pool_timeout: seconds Prisma waits for a free connection before timing out (10s)
# - connect_timeout: seconds to establish a DB connection before timing out (10s)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/ppong_nya?connection_limit=5&pool_timeout=10&connect_timeout=10"

# Public values are safe to expose to browser bundles and client-side code.
# PUBLIC_SITE_URL is required by src/lib/server/env.ts. PUBLIC_SITE_NAME is optional.
PUBLIC_SITE_URL="http://localhost:5173"
PUBLIC_SITE_NAME="퐁냐"

# Optional SvelteKit adapter-node runtime origin for deployments where SvelteKit
# cannot infer the request URL correctly. Keep it aligned with PUBLIC_SITE_URL
# when you set it. Local SvelteKit dev does not need this value.
ORIGIN="http://localhost:3000"
HOST="0.0.0.0"
PORT="3000"

# Production notes:
# - Set PUBLIC_SITE_URL to the canonical HTTPS origin, e.g. https://ppong-nya.mydepot.kr
# - Keep DATABASE_URL server-only. Do not prefix it with PUBLIC_.
