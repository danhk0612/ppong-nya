# External MariaDB connection string used by Prisma.
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://ppong_nya:ppong_nya_password@127.0.0.1:3306/ppong_nya"

# SvelteKit Node adapter runtime settings.
ORIGIN="http://localhost:3000"
PORT="3000"
HOST="0.0.0.0"

# Authentication secrets for future server-side auth integration.
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"
AUTH_SECRET="replace-me-with-a-long-random-string"
